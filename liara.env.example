# Paste these values in Liara Settings → Variables → COPY / PASTE.
# Replace every <...> value. Never commit a real key in this file.
INTERVIEW_PROVIDER=gapgpt
GAPGPT_API_KEY=<your-gapgpt-api-key>
GAPGPT_ENDPOINT=https://api.gapgpt.app/v1/chat/completions
GAPGPT_MODEL=gpt-5-nano
INTERVIEW_ARCHITECTURE=multi_agent_lite
# Allowed values: simple_adaptive, multi_agent_lite, conversational_lead
INTERVIEW_DB_PATH=database/interview-builder.db
INTERVIEW_LITE_WAIT_SECONDS=12
INTERVIEW_FAST_GUIDED_WAIT_SECONDS=10
DASHBOARD_SESSION_SECRET=<at-least-32-random-characters>
DASHBOARD_USERS_JSON=<the-single-line-json-from-create_dashboard_password.py>
